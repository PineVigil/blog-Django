# ============================================================
# toflower blog · 环境变量示例
# 复制为 .env 并填入实际值;.env 不应提交到 git
# ============================================================

# ---- Django 核心 ----
# 生产环境务必替换为随机字符串(50+ 字符)
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
# 生产环境设为 False
DJANGO_DEBUG=True
# 允许访问的主机(逗号分隔)
DJANGO_ALLOWED_HOSTS=toflower.fun,www.toflower.fun,150.109.76.168,localhost,127.0.0.1
# 后台路径(默认 dijia/,自建简约后台)
DJANGO_ADMIN_PATH=dijia/
# 原 Django admin 隐藏路径(默认 _djadmin/,作为备用逃生通道;勿对外公开)
DJANGO_NATIVE_ADMIN_PATH=_djadmin/

# ---- MySQL 数据库 ----
# 留空则回退到 SQLite(开发期)
DB_NAME=toflower_blog
DB_USER=toflower
DB_PASSWORD=your-strong-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- 站点信息 ----
SITE_EMAIL=admin@toflower.fun

# ---- 评论审核 ----
# True 表示评论需人工审核后才展示
COMMENT_REQUIRE_APPROVAL=False

# ---- 天气(和风天气) ----
# 首页天气卡片数据源;到 https://console.qweather.com 免费注册获取:
#   1. 创建项目 → 添加「免费订阅」
#   2. 添加凭据 → 选「API KEY」方式,复制 Key 填到 QWEATHER_KEY
#   3. 控制台「设置」里复制 API Host(形如 xxx.qweatherapi.com)填到 QWEATHER_API_HOST
# 留空 QWEATHER_KEY 时前端自动回退 Open-Meteo(精度一般)
QWEATHER_KEY=your-qweather-api-key-here
# 新账号必须填;老账号可留空(自动用默认域名)
QWEATHER_API_HOST=your-host.qweatherapi.com
